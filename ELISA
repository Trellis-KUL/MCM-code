def rinvchisq(n, df, variance_estimate):
    """
    Generate variance samples following inverse chi-square distribution

    This correctly models the uncertainty in variance estimates from small samples.
    Variance estimates follow chi-square distribution, not normal!

    Parameters:
    -----------
    n : int
        Number of samples to generate
    df : int
        Degrees of freedom (e.g., p-1 for between-series)
    variance_estimate : float
        Estimated variance (e.g., sd²)

    Returns:
    --------
    array of variance samples (always positive, right-skewed)
    """
    alpha = df / 2.0
    beta = alpha * variance_estimate
    draws = 1.0 / gamma.rvs(alpha, scale=1/beta, size=n)
    return draws


def sampleNormDist(Dist_mean, Dist_std, sample_size):
    return np.random.normal(Dist_mean, Dist_std, sample_size)


def apply_chauvenet_criterion(data):
    chauvenet_table = {
        3: 1.38, 4: 1.54, 5: 1.65, 6: 1.73, 7: 1.80, 8: 1.86, 9: 1.91, 10: 1.96,
        15: 2.13, 20: 2.24, 25: 2.33, 30: 2.39, 50: 2.57, 100: 2.81, 300: 3.14,
        500: 3.29, 1000: 3.48, 2000: 3.71, 5000: 3.97, 10000: 4.16, 50000: 4.50,
        100000: 4.42
    }
    N = len(data)
    if N in chauvenet_table:
        chauvenet_factor = chauvenet_table[N]
    else:
        available = sorted(chauvenet_table.keys())
        if N > available[-1]:
            chauvenet_factor = chauvenet_table[available[-1]]
        elif N < available[0]:
            chauvenet_factor = chauvenet_table[available[0]]
        else:
            lower = max(s for s in available if s <= N)
            upper = min(s for s in available if s >= N)
            fl = chauvenet_table[lower]; fu = chauvenet_table[upper]
            chauvenet_factor = fl + (fu - fl) * (N - lower) / (upper - lower)
    mean_val = np.mean(data)
    std_val = np.std(data, ddof=1)
    max_dev = chauvenet_factor * std_val
    mask = np.abs(data - mean_val) <= max_dev
    cleaned = data[mask]
    return cleaned, N - len(cleaned), chauvenet_factor


def find_reportable_range_by_interpolation(mcm_results, acceptance_limit=30):
    """
    Find reportable range where BOTH upper and lower expanded uncertainty bounds are within ±acceptance_limit
    """
    from scipy.interpolate import interp1d

    # Sort results by concentration
    results_sorted = sorted(mcm_results, key=lambda x: x['concentration'])

    concentrations = np.array([r['concentration'] for r in results_sorted])
    lower_bounds = np.array([r['eu_lower_95'] for r in results_sorted])
    upper_bounds = np.array([r['eu_upper_95'] for r in results_sorted])

    # Find valid concentration range
    log_concs = np.log10(concentrations)

    # Interpolate the bounds vs log concentration
    if len(concentrations) > 1:
        try:
            lower_interp = interp1d(log_concs, lower_bounds, kind='linear', fill_value='extrapolate')
            upper_interp = interp1d(log_concs, upper_bounds, kind='linear', fill_value='extrapolate')

            # Create fine grid for finding intersections
            log_conc_fine = np.linspace(log_concs.min(), log_concs.max(), 1000)
            lower_fine = lower_interp(log_conc_fine)
            upper_fine = upper_interp(log_conc_fine)
            conc_fine = 10**log_conc_fine

            # Find where BOTH bounds are within acceptance limits
            valid_mask = (lower_fine >= -acceptance_limit) & (upper_fine <= acceptance_limit)

            if np.any(valid_mask):
                valid_indices = np.where(valid_mask)[0]
                lloq_conc = conc_fine[valid_indices[0]]
                uloq_conc = conc_fine[valid_indices[-1]]

                return {
                    'lloq': lloq_conc,
                    'uloq': uloq_conc,
                    'valid': True,
                    'tested_range': (concentrations.min(), concentrations.max()),
                    'lloq_lower_bound': lower_interp(np.log10(lloq_conc)),
                    'lloq_upper_bound': upper_interp(np.log10(lloq_conc)),
                    'uloq_lower_bound': lower_interp(np.log10(uloq_conc)),
                    'uloq_upper_bound': upper_interp(np.log10(uloq_conc))
                }
        except Exception as e:
            print(f"  Warning: Interpolation failed: {e}")

    return {'valid': False}


