def print_mcm_summary(mcm_results):
    print("\n" + "="*120)
    print("MCM VALIDATION SUMMARY (CHI-SQUARE PRECISION MODEL - CORRECTED REPLICATE AVERAGING)")
    print("="*120)
    print(f"MCM Mean Bias Criterion: ±{MCM_MEAN_BIAS_LIMIT}%")
    print(f"MCM Acceptance Rate Criterion: ≥{MCM_ACCEPTANCE_RATE_TARGET}%")
    print(f"MCM Expanded Uncertainty Criterion: Both bounds within ±{MCM_INDIVIDUAL_BIAS_LIMIT}%")
    print(f"NOTE: Y sampled independently for each replicate - variance reduces by √n factor")

    mcm_valid_concentrations = []
    mcm_results_reversed = mcm_results[::-1]

    eu_pass = [r for r in mcm_results_reversed if r.get('pass_expanded_uncertainty', False)]

    print(f"\n{'Concentration':<15} {'n':<4} {'BW CV':<8} {'Rep CV':<8} {'Mean Bias (%)':<14} {'Accept Rate':<12} {'Exp Uncert':<12} {'Valid':<8}")
    print("-" * 120)
    for r in mcm_results_reversed:
        conc = r['concentration']
        n_rep = r['N_REPLICATES']
        bw_cv = r['BW_CV']
        rep_cv = r['REPEATABILITY_CV']
        mcm_mean = r['mean_bias']
        accept_rate = r['acceptance_rate']
        eu_pass_status = r['pass_expanded_uncertainty']
        mcm_valid = r['mcm_overall_valid']
        if mcm_valid:
            mcm_valid_concentrations.append(conc)
        rep_display = "Y_std" if rep_cv == 0 else f"{rep_cv:.1f}%"
        print(f"{conc:.2e}  {n_rep:<3}  {bw_cv:>5.1f}%  {rep_display:>7}  {mcm_mean:>11.2f}%  {accept_rate:>9.1f}%  {'YES' if eu_pass_status else 'NO':>10}  {'YES' if mcm_valid else 'NO':>6}")

    if eu_pass:
        print(f"\n  Computing interpolated reportable range...")
        interp_range = find_reportable_range_by_interpolation(mcm_results_reversed, MCM_INDIVIDUAL_BIAS_LIMIT)

        eu_concs = [r['concentration'] for r in eu_pass]
        eu_min, eu_max = min(eu_concs), max(eu_concs)
        print("\n" + "="*80)
        print("REPORTABLE RANGE")
        print("="*80)

        if interp_range['valid']:
            print(f"Interpolated Range: {interp_range['lloq']:.1e} – {interp_range['uloq']:.1e} Vp/mL")
        else:
            print(f"Discrete Range: {eu_min:.1e} – {eu_max:.1e} Vp/mL")

    print("\n" + "="*80)


