def print_summary(all_results, mode_cfg, mode_name):
    nominals = mode_cfg["nominals"]
    axis     = mode_cfg["axis"]
    pct_x    = sorted(nominals)
    print("\n" + "=" * 115)
    print("MASS PHOTOMETRY MCM VALIDATION SUMMARY — {} ({})".format(mode_name, axis))
    print("=" * 115)
    print("  {:>8} {:>6} | {:>6} | {:>5} | {:>9} | {:>8} | {:>24} | {:>8}".format(
        "Conc", axis, "BW CV", "n rep", "Mean Bias", "U95", "EU [lo, hi]", "Accept%"))
    print("-" * 115)
    for conc in concentrations_labels:
        for pct in pct_x:
            r = all_results[(conc, pct)]
            print("  {:>8} {:>5}% | {:>5.1f}% | {:>5} | {:>+8.2f}% | {:>7.2f}% | [{:>+9.2f},{:>+9.2f}]% | {:>7.1f}%".format(
                conc, pct, r["BW_CV"], r["N_REP"], r["mean_bias"], r["U_95"],
                r["eu_lo"], r["eu_hi"], r["accept_rate"]))
        print()


