# ============================================================================
# UTILITIES
# ============================================================================

def rinvchisq(n, df, var_est):
    # A zero (or non-positive) variance estimate means no variability to model;
    # return zeros instead of dividing by zero.
    if var_est <= 0:
        return np.zeros(n)
    alpha = df / 2.0
    beta  = alpha * var_est
    return 1.0 / gamma.rvs(alpha, scale=1.0 / beta, size=n)


def apply_chauvenet(arr):
    table = {3: 1.38,  4: 1.54,  5: 1.65,  6: 1.73,  7: 1.80,  8: 1.86,
             9: 1.91, 10: 1.96, 15: 2.13, 20: 2.24, 25: 2.33, 30: 2.39,
             50: 2.57, 100: 2.81, 300: 3.14, 500: 3.29, 1000: 3.48,
             2000: 3.71, 5000: 3.97, 10000: 4.16, 50000: 4.50, 100000: 4.42}
    N = len(arr)
    avail = sorted(table.keys())
    if N in table:
        cf = table[N]
    elif N > avail[-1]:
        cf = table[avail[-1]]
    elif N < avail[0]:
        cf = table[avail[0]]
    else:
        lo = max(s for s in avail if s <= N)
        hi = min(s for s in avail if s >= N)
        cf = table[lo] + (table[hi] - table[lo]) * (N - lo) / (hi - lo)
    mu = np.mean(arr)
    sd = np.std(arr, ddof=1)
    mask = np.abs(arr - mu) <= cf * sd
    return arr[mask], int(N - mask.sum()), cf


def _slot_offset(ci, n_series, bargap=BARGAP):
    """Centre of bar `ci` within its group, in category-index units.

    Resolution-independent, unlike a pixel-based xshift, which is tied to a
    specific figure width and series count.
    """
    slot = (1.0 - bargap) / n_series
    return (ci - (n_series - 1) / 2.0) * slot


# ============================================================================
# MCM SIMULATION (mode-parametrized)
# ============================================================================

def run_mp_mcm(mode_cfg, mode_name, n_trial=N_TRIAL, seed=42):
    np.random.seed(seed)
    results = {}
    nominals  = mode_cfg["nominals"]
    data      = mode_cfg["data"]
    bw_target = mode_cfg["bw_target"]
    nrep_tab  = mode_cfg["nrep"]
    axis      = mode_cfg["axis"]

    print("=" * 75)
    print("MASS PHOTOMETRY MCM SIMULATION — {} ({})".format(mode_name, axis))
    print("=" * 75)

    for conc in concentrations_labels:
        for nom_pct in nominals:
            d     = data[(conc, nom_pct)]
            BW_CV = bw_target[conc][nom_pct]
            N_REP = nrep_tab[conc][nom_pct]

            # ── BW instrument noise ──────────────────────────────────────────
            # BW_CV = 0 means no between-series error (skip chi-square sampling,
            # which would divide by zero on a zero variance estimate).
            if BW_CV == 0:
                BW_error = np.zeros(n_trial)
            else:
                var_BW = (BW_CV / 100.0 * nom_pct) ** 2
                var_BW_samples = rinvchisq(n_trial, DF_BW, var_BW)
                sd_BW  = np.sqrt(var_BW_samples)
                BW_error = np.random.normal(0, sd_BW)

            # ── Within-series (repeatability) variance is ALSO estimated from
            # few observations (df = DF_W), so sample it from an inverse
            # chi-square as well. This reproduces the Student-t /
            # Satterthwaite widening the Enoval report applies, and is what
            # brings the MCM risk into agreement with the report's
            # beta-expectation risk (mean |error| 1.70 -> 0.83 pp).
            var_w_samples = rinvchisq(n_trial, DF_W, max(d["pf_s"], 1e-6) ** 2)
            sd_w = np.sqrt(var_w_samples)

            # ── Simulate replicates directly from measured mean & SD ─────────
            X_reps = np.zeros((n_trial, N_REP))
            for rep in range(N_REP):
                pct_meas = np.clip(
                    d["pf_m"] + np.random.normal(0, sd_w), 0, 100
                )
                X_reps[:, rep] = np.clip(pct_meas + BW_error, 0, 100)

            X_mcm   = np.clip(np.mean(X_reps, axis=1), 0, 100)
            X_clean = X_mcm[np.isfinite(X_mcm)]
            X_chauv, n_out, cf = apply_chauvenet(X_clean)

            bias_rel  = (X_chauv - nom_pct) / nom_pct * 100.0
            mean_bias = float(np.mean(bias_rel))
            u_c       = float(np.std(bias_rel))
            U_95      = 1.96 * u_c
            eu_lo     = mean_bias - U_95
            eu_hi     = mean_bias + U_95
            accept_rate = float(np.mean(np.abs(bias_rel) <= MCM_BIAS_LIMIT) * 100.0)
            pass_eu   = (eu_lo >= -MCM_BIAS_LIMIT) and (eu_hi <= MCM_BIAS_LIMIT)
            pass_mean = abs(mean_bias) <= MCM_BIAS_LIMIT
            pass_rate = accept_rate >= MCM_ACCEPTANCE_TARGET
            overall   = pass_mean and pass_rate

            results[(conc, nom_pct)] = {
                "bias_rel":    bias_rel,
                "mean_bias":   mean_bias,
                "u_c":         u_c,
                "U_95":        U_95,
                "eu_lo":       eu_lo,
                "eu_hi":       eu_hi,
                "accept_rate": accept_rate,
                "pass_eu":     pass_eu,
                "pass_mean":   pass_mean,
                "pass_rate":   pass_rate,
                "overall":     overall,
                "outlier_pct": n_out / len(X_clean) * 100 if len(X_clean) > 0 else 0,
                "BW_CV":       BW_CV,
                "N_REP":       N_REP,
            }

            print("  {:>7} {:>3}%{} | n={} BW={:.1f}% | meas={:.1f}%±{:.2f}% | bias={:+.2f}% | accept={:.1f}% | {}".format(
                conc, nom_pct, mode_name[0], N_REP, BW_CV,
                d["pf_m"], d["pf_s"], mean_bias, accept_rate,
                "PASS" if overall else "FAIL"))

    return results


