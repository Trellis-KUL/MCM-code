                               (5.0, "red", "dash")]:
        fig.add_shape(type="line", x0=x_range[0], x1=x_range[1],
                      y0=y_val, y1=y_val,
                      line=dict(color=col_, width=2, dash=dash_), row=2, col=1)

    # ── LAYOUT ──────────────────────────────────────────────────────────────
    fig.update_layout(
        title=dict(
            text="Mass Photometry MCM Validation Summary — {}<br>".format(mode_name) +
                 "<span style='font-size:16px'>{} mean &amp; SD direct | BW noise | "
