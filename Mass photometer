    xtitle = "Theoretical {}".format(axis)

    # panel 1 axis
    if PANEL1_CATEGORICAL:
        fig.update_xaxes(tickvals=x_idx, ticktext=x_labels, range=x_range,
                         title=xtitle, title_font=dict(size=14), tickfont=dict(size=12),
                         tickangle=-30, showgrid=True, row=1, col=1)
    else:
        fig.update_xaxes(tickvals=pct_x, ticktext=x_labels, range=[0, 95],
                         title=xtitle, title_font=dict(size=14), tickfont=dict(size=12),
                         tickangle=-30, showgrid=True, row=1, col=1)

    # panels 2 and 3: always categorical
    for (r_, c_) in [(1, 2), (2, 1)]:
        fig.update_xaxes(tickvals=x_idx, ticktext=x_labels, range=x_range,
                         title=xtitle, title_font=dict(size=14), tickfont=dict(size=12),
                         tickangle=-30, showgrid=False, row=r_, col=c_)

    fig.update_yaxes(title_font=dict(size=14), tickfont=dict(size=12),
                     showgrid=True, gridcolor="rgba(0,0,0,0.07)")
    fig.update_yaxes(title="Relative Bias (%)", row=1, col=1)
    fig.update_yaxes(title="% Within +/-30% Bias<br><span style='font-size:12px'>"
                           "(Green=PASS Red=FAIL)</span>",
                     range=[0, 108], row=1, col=2)
    fig.update_yaxes(title="Outliers Removed (%)", row=2, col=1)
    fig.update_traces(cliponaxis=False)
    fig.show()
    return fig


# ============================================================================
# CONCORDANCE HEATMAP (mode-parametrized, 16 rows: concentration x level)
# ============================================================================

def compute_cell_acceptance(conc, nom_pct, bw_cv, mode_cfg, n_trial, rng):
    d     = mode_cfg["data"][(conc, nom_pct)]
    N_REP = mode_cfg["nrep"][conc][nom_pct]

    if bw_cv == 0:
        BW_error = np.zeros(n_trial)
    else:
        var_BW   = (bw_cv / 100.0 * nom_pct) ** 2
        var_samp = rinvchisq(n_trial, DF_BW, var_BW)
        BW_error = rng.normal(0, np.sqrt(var_samp))

    # within-series variance also sampled from inverse chi-square (df = DF_W)
    var_w    = rinvchisq(n_trial, DF_W, max(d["pf_s"], 1e-6) ** 2)
    sd_w     = np.sqrt(var_w)

    X_reps = np.zeros((n_trial, N_REP))
    for rep in range(N_REP):
        pct_meas = np.clip(d["pf_m"] + rng.normal(0, sd_w), 0, 100)
        X_reps[:, rep] = np.clip(pct_meas + BW_error, 0, 100)

    X_mcm   = np.clip(np.mean(X_reps, axis=1), 0, 100)
    X_clean = X_mcm[np.isfinite(X_mcm)]
    if len(X_clean) == 0:
        return 0.0
    bias = (X_clean - nom_pct) / nom_pct * 100.0
    return float(np.mean(np.abs(bias) <= MCM_BIAS_LIMIT) * 100.0)


def plot_concordance_heatmap(mode_cfg, mode_name, seed=123):
    nominals = mode_cfg["nominals"]
    axis     = mode_cfg["axis"]
    meas_bw  = mode_cfg["meas_bw"]
    val_pass = mode_cfg["val_pass"]
    nrep_tab = mode_cfg["nrep"]

    rng = np.random.default_rng(seed)
    bw_sweep = np.linspace(0, HM_BW_CV_MAX, HM_N_STEPS)

    # Row order bottom->top: low conc/low level first; y-axis reversed puts high conc on top
    row_cells = []
    for conc in concentrations_labels:                 # low -> high concentration
        for pct in sorted(nominals):                   # low -> high level
            row_cells.append((conc, pct))

    n_rows = len(row_cells)
    acc_matrix = np.zeros((n_rows, HM_N_STEPS))

    print("\nBuilding MP concordance heatmap — {} ({})".format(mode_name, axis))
    print("  BW CV sweep : 0 -> {}%  ({} steps)".format(HM_BW_CV_MAX, HM_N_STEPS))
    print("  Trials/cell : {:,}  |  Total cells: {}".format(HM_N_TRIAL, n_rows * HM_N_STEPS))

    for r, (conc, pct) in enumerate(row_cells):
        for j, bw in enumerate(bw_sweep):
            acc_matrix[r, j] = compute_cell_acceptance(conc, pct, bw, mode_cfg, HM_N_TRIAL, rng)
        print("  {:>7} {:>3}%{}  (n={}) -- done".format(conc, pct, mode_name[0], nrep_tab[conc][pct]))

    y_labels = ["{} cp/mL @ {}{}  n={}".format(conc, pct, axis, nrep_tab[conc][pct])
                for (conc, pct) in row_cells]

    fig = go.Figure()
    fig.add_trace(go.Heatmap(
        z=acc_matrix, x=bw_sweep, y=list(range(n_rows)),
        colorscale="RdYlGn", zmin=0, zmax=100,
        colorbar=dict(title=dict(
            text="MCM Acceptance Rate<br>(% within +/-{:.0f}% bias)".format(MCM_BIAS_LIMIT),
            side="right"), len=0.9),
        hovertemplate="BW CV: %{x:.1f}%<br>Acceptance: %{z:.1f}%<extra></extra>",
    ))

    # Per-row navy threshold bar
    for r in range(n_rows):
        below = np.where(acc_matrix[r] < MCM_ACCEPTANCE_TARGET)[0]
        if len(below) > 0:
            thr = bw_sweep[below[0]]
            fig.add_shape(type="line", x0=thr, x1=thr, y0=r - 0.45, y1=r + 0.45,
                          line=dict(color="navy", width=4), layer="above")

    # Measured-BW diamonds with concordance colouring
    legend_seen = set()
    for r, (conc, pct) in enumerate(row_cells):
        bw_meas  = meas_bw[conc][pct]
        vpass    = val_pass[conc][pct]
        j_near   = int(np.argmin(np.abs(bw_sweep - bw_meas)))
        mcm_acc  = acc_matrix[r, j_near]
        mcm_pass = mcm_acc >= MCM_ACCEPTANCE_TARGET

        if mcm_pass and vpass:
            colr, key, lbl = "#00E5FF", "cp", "Concordant - both PASS"
        elif (not mcm_pass) and (not vpass):
            colr, key, lbl = "#FF3030", "cf", "Concordant - both FAIL"
        else:
            colr, key, lbl = "#FFA500", "dc", "Discordant (MCM != Validation)"

        show = key not in legend_seen
        legend_seen.add(key)

        fig.add_trace(go.Scatter(
            x=[bw_meas], y=[r], mode="markers+text",
            marker=dict(symbol="diamond", size=16, color=colr, line=dict(color="white", width=1.5)),
            text=["  {:.1f}% ({:.0f}%)".format(bw_meas, mcm_acc)],
            textposition="middle right", textfont=dict(size=9, color="black"),
            name=lbl, legendgroup=key, showlegend=show,
            hovertemplate="{} @ {}{}<br>Measured BW: {:.1f}%<br>MCM acceptance: {:.0f}%<extra></extra>".format(
                conc, pct, axis, bw_meas, mcm_acc),
        ))

    fig.add_trace(go.Scatter(
        x=[None], y=[None], mode="lines", line=dict(color="navy", width=4),
        name="{:.0f}% acceptance threshold".format(MCM_ACCEPTANCE_TARGET), showlegend=True,
    ))

    fig.update_layout(
        title=dict(
            text="Mass Photometry MCM Concordance Heatmap — {} ({})<br>".format(mode_name, axis) +
                 "<span style='font-size:14px'>Acceptance rate vs between-series precision | "
                 "diamonds = measured BW CV (annotation: BW%, MCM acceptance%) | "
                 "navy bar = {:.0f}% threshold</span>".format(MCM_ACCEPTANCE_TARGET),
            font=dict(size=20)),
        xaxis=dict(title="Between-Series CV (%)", title_font=dict(size=14),
                   range=[0, HM_BW_CV_MAX], showgrid=False),
        yaxis=dict(tickmode="array", tickvals=list(range(n_rows)), ticktext=y_labels,
                   tickfont=dict(size=11, family="monospace"),
                   title="Concentration @ {}".format(axis), title_font=dict(size=14),
                   autorange="reversed"),
        plot_bgcolor="white",
        legend=dict(font=dict(size=11), bgcolor="rgba(255,255,255,0.9)",
                    bordercolor="gray", borderwidth=1, yanchor="top", y=0.99,
                    xanchor="right", x=0.99),
        width=1500, height=900, margin=dict(t=120, b=70, l=240, r=40),
    )
    fig.show()
    return fig, acc_matrix, row_cells


