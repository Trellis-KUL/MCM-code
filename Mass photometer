def plot_graphs(all_results, mode_cfg, mode_name):
    nominals = mode_cfg["nominals"]
    axis     = mode_cfg["axis"]

    pct_x    = sorted(nominals)                # ascending nominal levels
    x_idx    = list(range(len(pct_x)))         # category positions 0..k-1
    x_labels = ["{}%".format(p) for p in pct_x]
    n_conc   = len(concentrations_labels)
    x_range  = [-X_PAD, len(pct_x) - 1 + X_PAD]

    fig = make_subplots(
        rows=2, cols=2,
        subplot_titles=("MCM Bias Distribution", "MCM Acceptance Rate",
                        "Chauvenet Criterion - Outlier Removal Analysis", ""),
        horizontal_spacing=0.10, vertical_spacing=0.18,
    )

    # ── GRAPH 1: Bias scatter + EU band + mean line ─────────────────────────
    xp        = x_idx if PANEL1_CATEGORICAL else pct_x
    jitter_sd = 0.04 if PANEL1_CATEGORICAL else 0.5

    for ci, conc in enumerate(concentrations_labels):
        col    = colors[ci]
        means  = [all_results[(conc, p)]["mean_bias"] for p in pct_x]
        eu_los = [all_results[(conc, p)]["eu_lo"]     for p in pct_x]
        eu_his = [all_results[(conc, p)]["eu_hi"]     for p in pct_x]

        r_int = int(col[1:3], 16); g_int = int(col[3:5], 16); b_int = int(col[5:7], 16)
        fill_col = "rgba({},{},{},0.10)".format(r_int, g_int, b_int)
        line_col = "rgba({},{},{},0.65)".format(r_int, g_int, b_int)

        fig.add_trace(go.Scatter(
            x=list(xp) + list(xp)[::-1], y=eu_his + eu_los[::-1],
            fill="toself", fillcolor=fill_col, line=dict(color="rgba(0,0,0,0)"),
            showlegend=False, hoverinfo="skip", mode="lines",
        ), row=1, col=1)

        for y_band in [eu_his, eu_los]:
            fig.add_trace(go.Scatter(
                x=xp, y=y_band, mode="lines",
                line=dict(color=line_col, dash="dash", width=1.5),
                showlegend=False, hoverinfo="skip",
            ), row=1, col=1)

        for k, pct in enumerate(pct_x):
            xc        = xp[k]
            bias_arr  = all_results[(conc, pct)]["bias_rel"]
            n_scatter = min(200, len(bias_arr))
            idx  = np.random.choice(len(bias_arr), n_scatter, replace=False)
            vals = bias_arr[idx]
            xjit = np.random.normal(xc, jitter_sd, n_scatter)
            fig.add_trace(go.Scatter(
                x=xjit, y=vals, mode="markers",
                marker=dict(color=col, size=4, opacity=0.25),
                showlegend=False, hoverinfo="skip",
            ), row=1, col=1)
            if ci == 0:
                fig.add_annotation(
                    x=xc, y=float(np.percentile(bias_arr, 98.5)) + 1,
                    text="n={}".format(all_results[(conc, pct)]["N_REP"]),
                    showarrow=False, font=dict(size=10, color="black", family="Arial Black"),
                    yanchor="bottom", bgcolor="rgba(255,255,240,0.85)",
                    bordercolor="gray", borderwidth=0.8, row=1, col=1,
                )

        fig.add_trace(go.Scatter(
            x=xp, y=means, mode="lines+markers",
            line=dict(color=col, width=2.5),
            marker=dict(size=9, color=col, line=dict(width=2, color="white")),
            name=conc + " cp/mL", legendgroup=conc,
            customdata=[[p] for p in pct_x],
            hovertemplate="<b>%{customdata[0]} " + axis +
                          "</b><br>Mean bias: %{y:.1f}%<extra>" + conc + "</extra>",
        ), row=1, col=1)

    p1_range = x_range if PANEL1_CATEGORICAL else [0, 95]
    for y_val, col_, dash_ in [( MCM_BIAS_LIMIT, "black", "dash"),
                               (-MCM_BIAS_LIMIT, "black", "dash"),
                               (0,               "gray",  "dot")]:
        fig.add_shape(type="line", x0=p1_range[0], x1=p1_range[1],
                      y0=y_val, y1=y_val,
                      line=dict(color=col_, width=1.8, dash=dash_), row=1, col=1)

    # ── GRAPH 2: Acceptance rate bars (categorical x) ───────────────────────
    for ci, conc in enumerate(concentrations_labels):
        rates  = [all_results[(conc, p)]["accept_rate"] for p in pct_x]
        passes = [all_results[(conc, p)]["overall"]     for p in pct_x]
        bar_cols = ["rgba(0,160,0,0.85)" if p else "rgba(210,40,40,0.85)" for p in passes]

        fig.add_trace(go.Bar(
            x=x_idx, y=rates, name=conc + " cp/mL",
            marker_color=bar_cols, marker_line=dict(color="black", width=1),
            text=["{:.1f}%".format(r) for r in rates], textposition="outside",
            textfont=dict(size=9, color="black"), showlegend=False,
        ), row=1, col=2)

        # in-bar concentration label, positioned in category units
