                fig.add_annotation(
                    x=x_idx[k] + _slot_offset(ci, n_conc), y=6,
                    text=conc, showarrow=False, textangle=-90,
                    font=dict(size=10, color="black", family="Arial Black"),
                    xanchor="center", yanchor="middle", row=1, col=2,
                )

    fig.add_shape(type="line", x0=x_range[0], x1=x_range[1],
                  y0=MCM_ACCEPTANCE_TARGET, y1=MCM_ACCEPTANCE_TARGET,
                  line=dict(color="orange", width=2.5, dash="solid"), row=1, col=2)

    # ── GRAPH 3: Chauvenet outlier removal (categorical x) ──────────────────
