def run_mcm_with_chi_square_precision(n_trial=100000):
    # ddPCR parameters - YOUR MEASURED DATA
    N_neg_mean = [19.25, 236.25 , 16646.75, 18561, 18836]
    N_neg_std = [8.341, 46.99, 855.85, 354.78, 809.62]

    P_mean = [17390, 16727.5, 1406, 170.0, 93.75]
    P_std = [673.006, 388.1284, 89.02, 15.14, 11.08]

    T_mean = [17409.25, 16963.75, 18052.75, 18731, 18929.75]
    T_std = [679.89, 348.38, 859.94, 349.268, 819.04]

    V_droplet_mean = 0.00085
    V_droplet_std = 0.00  # No uncertainty in droplet volume

    print(f"\nRunning ddPCR MCM simulations with {n_trial} trials per concentration...")
    print("Using CHI-SQUARE distribution for precision variance sampling")
    print("Using CONCENTRATION-SPECIFIC precision parameters and replicates")
    print("CORRECTED: Parameters sampled independently for each replicate\n")

    mcm_distributions = []

    for i, true_conc in enumerate(concentrations):
        # Get concentration-specific parameters
        BW_CV = BW_CV_PER_CONC[i]
        REPEATABILITY_CV = REPEATABILITY_CV_PER_CONC[i]
        N_REPLICATES = N_REPLICATES_PER_CONC[i]

        # Calculate concentration-specific degrees of freedom
        DF_REPEATABILITY = P_SERIES * (N_REPLICATES - 1)

        print(f"\nSimulating concentration {i+1}/{len(concentrations)}: {true_conc:.2e} Copies/μL")
        print(f"  Using BW CV = {BW_CV:.1f}%, Repeatability CV = {REPEATABILITY_CV:.1f}%, n_replicates = {N_REPLICATES}")
        print(f"  Degrees of freedom: BW = {DF_BW}, Repeatability = {DF_REPEATABILITY}")

        # Calculate variance estimates
        var_BW_estimate = (BW_CV/100.0 * true_conc) ** 2
        var_Rep_estimate = (REPEATABILITY_CV/100.0 * true_conc) ** 2

        print(f"  Between-series variance estimate: {var_BW_estimate:.2e}")
        print(f"  Repeatability variance estimate: {var_Rep_estimate:.2e}")

        # Generate variance distributions using INVERSE CHI-SQUARE
        variance_BW_samples = rinvchisq(n_trial, DF_BW, var_BW_estimate)

        # Handle zero repeatability CV
        if REPEATABILITY_CV > 0 and DF_REPEATABILITY > 0:
            variance_Rep_samples = rinvchisq(n_trial, DF_REPEATABILITY, var_Rep_estimate)
            print(f"  BW variance samples: mean={np.mean(variance_BW_samples):.2e}, "
                  f"min={np.min(variance_BW_samples):.2e}, max={np.max(variance_BW_samples):.2e}")
            print(f"  Rep variance samples: mean={np.mean(variance_Rep_samples):.2e}, "
                  f"min={np.min(variance_Rep_samples):.2e}, max={np.max(variance_Rep_samples):.2e}")
        else:
            variance_Rep_samples = np.zeros(n_trial)
            print(f"  BW variance samples: mean={np.mean(variance_BW_samples):.2e}, "
                  f"min={np.min(variance_BW_samples):.2e}, max={np.max(variance_BW_samples):.2e}")
            print(f"  Rep variance samples: All zeros (repeatability in parameter uncertainty)")

        # Initialize array for replicates
        X_replicates = np.zeros((n_trial, N_REPLICATES))

        # CORRECTED: For each trial, generate replicates with INDEPENDENT parameter sampling
        for trial in range(n_trial):
            # Sample SD from chi-square distributed variances
            sd_BW_this_trial = np.sqrt(variance_BW_samples[trial])
            sd_Rep_this_trial = np.sqrt(variance_Rep_samples[trial])

            # Add between-series error (same for all replicates in this trial/series)
            BW_error = np.random.normal(0, sd_BW_this_trial)

            # CORRECTED: Sample ddPCR parameters independently for EACH replicate
            for rep in range(N_REPLICATES):
                # Each replicate gets independent parameter samples (all scalars)
                N_neg_this_rep = np.random.normal(N_neg_mean[i], N_neg_std[i])
                P_this_rep = np.random.normal(P_mean[i], P_std[i])
                T_this_rep = np.random.normal(T_mean[i], T_std[i])
                V_droplet_this_rep = V_droplet_mean  # Scalar, no uncertainty

                # Calculate concentration using conditional formula (scalar operations)
                # FIXED: No array indexing - direct scalar calculation
                if N_neg_this_rep < T_this_rep / 2:
                    X_true_replicate = -np.log(N_neg_this_rep / T_this_rep) / V_droplet_this_rep
                else:
                    X_true_replicate = -np.log(1 - P_this_rep / T_this_rep) / V_droplet_this_rep

                # Add between-series error (shared) and repeatability error (independent)
                Rep_error = np.random.normal(0, sd_Rep_this_trial)
                X_replicates[trial, rep] = X_true_replicate + BW_error + Rep_error

        # Take mean across replicates (averaging effect works!)
        X_mcm = np.mean(X_replicates, axis=1)

        # Remove invalid values
        valid_mask = np.isfinite(X_mcm) & (X_mcm > 0)
        X_clean_initial = X_mcm[valid_mask]

        print(f"  Initial valid simulations: {len(X_clean_initial):,}/{n_trial:,}")

        # Apply Chauvenet criterion
        X_clean_chauvenet, outliers_removed, chauvenet_factor = apply_chauvenet_criterion(X_clean_initial)

        print(f"  Chauvenet factor: {chauvenet_factor:.2f}")
        print(f"  Outliers removed by Chauvenet: {outliers_removed:,}")
        print(f"  Final cleaned data points: {len(X_clean_chauvenet):,}")
        print(f"  Outlier percentage: {(outliers_removed/len(X_clean_initial)*100):.2f}%")

        # Calculate bias distribution
        mcm_bias_distribution = ((X_clean_chauvenet - true_conc) / true_conc) * 100

        mcm_distributions.append({
            'concentration': true_conc,
            'BW_CV': BW_CV,
            'REPEATABILITY_CV': REPEATABILITY_CV,
            'N_REPLICATES': N_REPLICATES,
            'DF_REPEATABILITY': DF_REPEATABILITY,
            'X_mcm': X_clean_chauvenet,
            'X_mcm_original': X_clean_initial,
            'mcm_bias_distribution': mcm_bias_distribution,
            'outliers_removed': outliers_removed,
            'chauvenet_factor': chauvenet_factor,
            'outlier_percentage': (outliers_removed/len(X_clean_initial)*100),
            'variance_BW_samples': variance_BW_samples,
            'variance_Rep_samples': variance_Rep_samples
        })

    return mcm_distributions


def evaluate_mcm_validation_with_chauvenet(mcm_distributions):
    print(f"\nEvaluating MCM with Chauvenet-cleaned data:")
    print(f"  Mean bias limit: ±{MCM_MEAN_BIAS_LIMIT}%")
    print(f"  Acceptance rate target: ≥{MCM_ACCEPTANCE_RATE_TARGET}%")
    print(f"  Expanded Uncertainty criterion: Both bounds within ±{MCM_INDIVIDUAL_BIAS_LIMIT}%")

    mcm_results = []
    for mcm_data in mcm_distributions:
        conc = mcm_data['concentration']
        bias_dist = mcm_data['mcm_bias_distribution']
        X_clean = mcm_data['X_mcm']

        mean_bias = np.mean(bias_dist)
        mean_bias_absolute = (mean_bias / 100) * conc
        std_bias_relative = np.std(bias_dist)

        mcm_abs_mean = np.mean(X_clean)
        mcm_abs_std = np.std(X_clean)
        mcm_abs_min = np.min(X_clean)
        mcm_abs_max = np.max(X_clean)
        mcm_abs_range = mcm_abs_max - mcm_abs_min

        abs_bias_dist = X_clean - conc
        abs_bias_mean = np.mean(abs_bias_dist)
        abs_bias_std = np.std(abs_bias_dist)

        acceptance_rate = (np.sum(np.abs(bias_dist) <= MCM_INDIVIDUAL_BIAS_LIMIT) / len(bias_dist)) * 100

        u_c = np.std(bias_dist)
        U_95 = 1.96 * u_c
        eu_lower = mean_bias - U_95
        eu_upper = mean_bias + U_95

        u_c_abs = np.std(abs_bias_dist)
        U_95_abs = 1.96 * u_c_abs

        pass_expanded_uncertainty = (eu_lower >= -MCM_INDIVIDUAL_BIAS_LIMIT) and (eu_upper <= MCM_INDIVIDUAL_BIAS_LIMIT)

        mean_bias_valid = abs(mean_bias) <= MCM_MEAN_BIAS_LIMIT
        acceptance_rate_valid = acceptance_rate >= MCM_ACCEPTANCE_RATE_TARGET
        mcm_overall_valid = mean_bias_valid and acceptance_rate_valid

        mcm_results.append({
            'concentration': conc,
            'BW_CV': mcm_data['BW_CV'],
            'REPEATABILITY_CV': mcm_data['REPEATABILITY_CV'],
            'N_REPLICATES': mcm_data['N_REPLICATES'],
            'DF_REPEATABILITY': mcm_data['DF_REPEATABILITY'],
            'mean_bias': mean_bias,
            'mean_bias_absolute': mean_bias_absolute,
            'std_bias_relative': std_bias_relative,
            'u_combined': u_c,
            'expanded_uncertainty': U_95,
            'eu_lower_95': eu_lower,
            'eu_upper_95': eu_upper,
            'mcm_abs_mean': mcm_abs_mean,
            'mcm_abs_std': mcm_abs_std,
            'mcm_abs_min': mcm_abs_min,
            'mcm_abs_max': mcm_abs_max,
            'mcm_abs_range': mcm_abs_range,
            'abs_bias_mean': abs_bias_mean,
            'abs_bias_std': abs_bias_std,
            'u_combined_abs': u_c_abs,
            'expanded_uncertainty_abs': U_95_abs,
            'acceptance_rate': acceptance_rate,
            'pass_expanded_uncertainty': pass_expanded_uncertainty,
            'mean_bias_valid': mean_bias_valid,
            'acceptance_rate_valid': acceptance_rate_valid,
            'mcm_overall_valid': mcm_overall_valid,
            'bias_distribution': bias_dist,
            'outliers_removed': mcm_data['outliers_removed'],
            'chauvenet_factor': mcm_data['chauvenet_factor'],
            'outlier_percentage': mcm_data['outlier_percentage'],
            'original_data_size': len(mcm_data['X_mcm_original']),
            'cleaned_data_size': len(mcm_data['X_mcm'])
        })

        print(f"  {conc:.1e}: Mean bias = {mean_bias:6.1f}% ({mean_bias_absolute:.1e} Copies/μL) ({'PASS' if mean_bias_valid else 'FAIL'}), "
              f"Accept rate = {acceptance_rate:5.1f}% ({'PASS' if acceptance_rate_valid else 'FAIL'}), "
              f"Expanded uncertainty within ±{MCM_INDIVIDUAL_BIAS_LIMIT}% = {'YES' if pass_expanded_uncertainty else 'NO'} "
              f"→ {'VALID' if mcm_overall_valid else 'INVALID'}")
    return mcm_results


