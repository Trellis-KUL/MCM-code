    print(f"MCM Expanded Uncertainty Criterion: Both bounds within ±{MCM_INDIVIDUAL_BIAS_LIMIT}%")
    print(f"NOTE: Parameters sampled independently for each replicate - variance reduces by √n factor")

    mcm_valid_concentrations = []
    mcm_results_reversed = mcm_results[::-1]

    eu_pass = [r for r in mcm_results_reversed if r.get('pass_expanded_uncertainty', False)]

    print(f"\n{'Concentration':<15} {'n':<4} {'BW CV':<8} {'Rep CV':<8} {'Mean Bias (%)':<14} {'Accept Rate':<12} {'Exp Uncert':<12} {'Valid':<8}")
    print("-" * 120)
    for r in mcm_results_reversed:
        conc = r['concentration']
        n_rep = r['N_REPLICATES']
        bw_cv = r['BW_CV']
        rep_cv = r['REPEATABILITY_CV']
        mcm_mean = r['mean_bias']
        accept_rate = r['acceptance_rate']
        eu_pass_status = r['pass_expanded_uncertainty']
        mcm_valid = r['mcm_overall_valid']
        if mcm_valid:
            mcm_valid_concentrations.append(conc)
        rep_display = "Params" if rep_cv == 0 else f"{rep_cv:.1f}%"
        print(f"{conc:.2e}  {n_rep:<3}  {bw_cv:>5.1f}%  {rep_display:>7}  {mcm_mean:>11.2f}%  {accept_rate:>9.1f}%  {'YES' if eu_pass_status else 'NO':>10}  {'YES' if mcm_valid else 'NO':>6}")

